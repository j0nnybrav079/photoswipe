plugin.tx_photoswipe {

    view {
        layoutRootPath = EXT:photoswipe/Resources/Private/Layouts/
        templateRootPath = EXT:photoswipe/Resources/Private/Templates/
    }

    settings {
        imageExtensions = jpg,jpeg,png,bmp
        svgWidth = 10
    }

}

# "styles.content.textmedia.linkWrap.lightboxEnabled = 1" liegt seit dem
# Umstieg auf Site Sets in Configuration/Sets/PhotoSwipe/settings.yaml -
# der Wert ist ein Setting des Sets typo3/fluid-styled-content und laesst
# sich dort sauber ueberschreiben.
